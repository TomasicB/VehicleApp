@model IEnumerable<Vehicle.DAL.Entities.VehicleRegistration>

@{
    ViewData["Title"] = "VehicleRegistrationListView";
}

<h1>VehicleRegistrationListView</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.RegistrationNumber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.VehicleModel)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.VehicleEngine)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.VehicleOwner)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.RegistrationNumber)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.VehicleModel.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.VehicleEngine.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.VehicleOwner.Id)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
